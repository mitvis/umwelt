{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "AudioAggregateOp": {
            "enum": [
                "count",
                "mean"
            ],
            "type": "string"
        },
        "AudioEncoding": {
            "properties": {
                "duration": {
                    "$ref": "#/definitions/AudioEncodingFieldDef"
                },
                "pitch": {
                    "$ref": "#/definitions/AudioEncodingFieldDef"
                },
                "volume": {
                    "$ref": "#/definitions/AudioEncodingFieldDef"
                }
            },
            "type": "object"
        },
        "AudioEncodingFieldDef": {
            "properties": {
                "aggregate": {
                    "$ref": "#/definitions/NonArgAggregateOp"
                },
                "field": {
                    "type": "string"
                },
                "scale": {
                    "properties": {
                        "domain": {
                            "items": {},
                            "type": "array"
                        },
                        "nice": {
                            "type": [
                                "number",
                                "boolean"
                            ]
                        },
                        "zero": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "timeUnit": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "AudioEncodingSelectionTarget": {
            "properties": {
                "aggregate": {
                    "$ref": "#/definitions/AudioAggregateOp"
                },
                "property": {
                    "$ref": "#/definitions/AudioPropName"
                }
            },
            "type": "object"
        },
        "AudioPropName": {
            "enum": [
                "duration",
                "pitch",
                "volume"
            ],
            "type": "string"
        },
        "AudioSpec": {
            "properties": {
                "units": {
                    "items": {
                        "properties": {
                            "encoding": {
                                "$ref": "#/definitions/AudioEncoding"
                            },
                            "name": {
                                "type": "string"
                            },
                            "traversal": {
                                "items": {
                                    "$ref": "#/definitions/AudioTraversalFieldDef"
                                },
                                "type": "array"
                            }
                        },
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "AudioTraversalFieldDef": {
            "properties": {
                "bin": {
                    "type": "boolean"
                },
                "field": {
                    "type": "string"
                },
                "mode": {
                    "enum": [
                        "interactive",
                        "sequential"
                    ],
                    "type": "string"
                },
                "scale": {
                    "properties": {
                        "domain": {
                            "items": {},
                            "type": "array"
                        },
                        "nice": {
                            "type": [
                                "number",
                                "boolean"
                            ]
                        },
                        "zero": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "timeUnit": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ConcatViewComposition": {
            "properties": {
                "concat": {
                    "items": {
                        "$ref": "#/definitions/ViewComposition"
                    },
                    "type": "array"
                },
                "direction": {
                    "enum": [
                        "horizontal",
                        "vertical"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "DomainSelectionTarget": {
            "properties": {
                "rescale": {
                    "type": "boolean"
                },
                "target": {
                    "enum": [
                        "text-domain",
                        "visual-domain"
                    ],
                    "type": "string"
                }
            },
            "type": "object"
        },
        "EncodingPropName": {
            "enum": [
                "color",
                "column",
                "detail",
                "duration",
                "facet",
                "opacity",
                "pitch",
                "row",
                "shape",
                "volume",
                "x",
                "y"
            ],
            "type": "string"
        },
        "EncodingRef": {
            "properties": {
                "property": {
                    "$ref": "#/definitions/EncodingPropName"
                },
                "unit": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "FieldDef": {
            "properties": {
                "aggregate": {
                    "$ref": "#/definitions/NonArgAggregateOp"
                },
                "bin": {
                    "type": "boolean"
                },
                "encodings": {
                    "items": {
                        "$ref": "#/definitions/EncodingRef"
                    },
                    "type": "array"
                },
                "name": {
                    "type": "string"
                },
                "scale": {
                    "properties": {
                        "domain": {
                            "items": {},
                            "type": "array"
                        },
                        "nice": {
                            "type": "boolean"
                        },
                        "zero": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "timeUnit": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/MeasureType"
                }
            },
            "type": "object"
        },
        "FieldRef": {
            "properties": {
                "field": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "LayerViewComposition": {
            "properties": {
                "layer": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "Mark": {
            "description": "All types of primitive marks.",
            "enum": [
                "arc",
                "area",
                "bar",
                "circle",
                "geoshape",
                "image",
                "line",
                "point",
                "rect",
                "rule",
                "square",
                "text",
                "tick",
                "trail"
            ],
            "type": "string"
        },
        "MeasureType": {
            "enum": [
                "nominal",
                "ordinal",
                "quantitative",
                "temporal"
            ],
            "type": "string"
        },
        "NonArgAggregateOp": {
            "enum": [
                "average",
                "ci0",
                "ci1",
                "count",
                "distinct",
                "max",
                "mean",
                "median",
                "min",
                "missing",
                "product",
                "q1",
                "q3",
                "stderr",
                "stdev",
                "stdevp",
                "sum",
                "valid",
                "values",
                "variance",
                "variancep"
            ],
            "type": "string"
        },
        "SelectionSpec": {
            "properties": {
                "targets": {
                    "items": {
                        "$ref": "#/definitions/SelectionTarget"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        },
        "SelectionTarget": {
            "anyOf": [
                {
                    "$ref": "#/definitions/AudioEncodingSelectionTarget"
                },
                {
                    "$ref": "#/definitions/VisualEncodingSelectionTarget"
                },
                {
                    "$ref": "#/definitions/DomainSelectionTarget"
                }
            ]
        },
        "ValueRef": {
            "properties": {
                "value": {}
            },
            "type": "object"
        },
        "ViewComposition": {
            "anyOf": [
                {
                    "$ref": "#/definitions/LayerViewComposition"
                },
                {
                    "$ref": "#/definitions/ConcatViewComposition"
                },
                {
                    "type": "string"
                }
            ]
        },
        "VisualEncoding": {
            "properties": {
                "color": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "column": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "detail": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "facet": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "opacity": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "row": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "shape": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "x": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                },
                "y": {
                    "$ref": "#/definitions/VisualEncodingFieldDef"
                }
            },
            "type": "object"
        },
        "VisualEncodingFieldDef": {
            "properties": {
                "aggregate": {
                    "$ref": "#/definitions/NonArgAggregateOp"
                },
                "bin": {
                    "type": "boolean"
                },
                "field": {
                    "type": "string"
                },
                "scale": {
                    "properties": {
                        "domain": {
                            "items": {},
                            "type": "array"
                        },
                        "nice": {
                            "type": [
                                "number",
                                "boolean"
                            ]
                        },
                        "zero": {
                            "type": "boolean"
                        }
                    },
                    "type": "object"
                },
                "timeUnit": {
                    "type": "string"
                }
            },
            "type": "object"
        },
        "VisualEncodingSelectionTarget": {
            "properties": {
                "property": {
                    "$ref": "#/definitions/VisualPropName"
                },
                "selected": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/FieldRef"
                        },
                        {
                            "$ref": "#/definitions/ValueRef"
                        }
                    ]
                },
                "unselected": {
                    "$ref": "#/definitions/ValueRef"
                }
            },
            "type": "object"
        },
        "VisualPropName": {
            "enum": [
                "color",
                "column",
                "detail",
                "facet",
                "opacity",
                "row",
                "shape",
                "x",
                "y"
            ],
            "type": "string"
        },
        "VisualSpec": {
            "properties": {
                "composition": {
                    "$ref": "#/definitions/ViewComposition"
                },
                "units": {
                    "items": {
                        "properties": {
                            "encoding": {
                                "$ref": "#/definitions/VisualEncoding"
                            },
                            "mark": {
                                "$ref": "#/definitions/Mark"
                            },
                            "name": {
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    "type": "array"
                }
            },
            "type": "object"
        }
    },
    "properties": {
        "audio": {
            "anyOf": [
                {
                    "items": {
                        "$ref": "#/definitions/AudioSpec"
                    },
                    "type": "array"
                },
                {
                    "const": false,
                    "type": "boolean"
                }
            ]
        },
        "data": {
            "properties": {
                "values": {}
            },
            "type": "object"
        },
        "fields": {
            "items": {
                "$ref": "#/definitions/FieldDef"
            },
            "type": "array"
        },
        "selection": {
            "$ref": "#/definitions/SelectionSpec"
        },
        "text": {},
        "visual": {
            "anyOf": [
                {
                    "$ref": "#/definitions/VisualSpec"
                },
                {
                    "const": false,
                    "type": "boolean"
                }
            ]
        }
    },
    "type": "object"
}

